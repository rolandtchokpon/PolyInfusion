@startuml diagramme_classes
title Diagramme de classes - Machine à thé
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members

' =====================================================
'  CONSOLE
' =====================================================
namespace Console {
    enum Mot {
        Selection
        Remplir
        Notifications
        Infuser
        Reserves
        Portions
        Configuration
        Routine
        Apercu
        Undo
        Redo
        Aide
        Quitter
        Inconnu
    }

    enum TypeInstruction {
        Vide
        Selection
        Infuser
        Reserves
        RemplirEau
        RemplirThe
        Notifications
        Aide
        Apercu
        Config
        Undo
        Redo
        Routine
        Portion
        Quitter
        Invalide
    }

    class Instruction <<struct>> {
        + type : TypeInstruction = Vide
        + the : string
        + routine : string
        + portions : unsigned int
        + quantite : double = 0.0
        + notificationsActives : bool = false
        + erreur : string
    }

    class InterfaceConsole {
        + InterfaceConsole()
        + ~InterfaceConsole()
        + analyser(ligne : const string&) : const Instruction&
        - estUnThe(valeur : const string&) : bool
        - invalide(message : const string&) : Instruction
        - lireQuantite(texte : const string&, quantite : double&) : bool
        - lireMot(nom : const string&) : Mot
    }
}

' =====================================================
'  COMMANDE (pattern Command)
' =====================================================
namespace CMD {
    abstract class Commande {
        # instruction_ : Console::Instruction
        # estReversible_ : bool
        # Commande(estReversible : bool)
        + {abstract} ~Commande()
        + {abstract} executer(inst : const Instruction&, sys : Systeme*) : void
        + {abstract} undo(sys : Systeme*) : void
        + sauvgarde() : const Instruction&
        + estReversible() : bool
    }

    class CmdAide
    class CmdApercu
    class CmdConfig
    class CmdInfuser
    class CmdNotif
    class CmdQuit
    class CmdRemplirEau
    class CmdRemplirThe
    class CmdReserve
    class CmdSelection

    class CmdPortion {
        - portionsAvant_ : int = -1
    }

    class CmdRoutine {
        - routine_ : Machine::TypeRoutine
        - lireRoutine(r : const string&) : Machine::TypeRoutine
    }
}

' =====================================================
'  EXECUTION
' =====================================================
namespace Execution {
    class Executeur {
        - sys_ : Machine::Systeme*
        - hist_ : unique_ptr<Historique>
        + Executeur(sys : Machine::Systeme*)
        + executer(inst : const Console::Instruction&) : void
        - commande(inst : const Console::Instruction&) : shared_ptr<CMD::Commande>&
    }

    class Historique {
        - dernierUndo_ : shared_ptr<Commande>
        - Reversibles_ : vector<shared_ptr<Commande>>
        + undo(sys : Machine::Systeme*) : void
        + redo(sys : Machine::Systeme*) : void
        + ajouter(c : shared_ptr<Commande>&) : void
    }
}

' =====================================================
'  FABRIQUE (Abstract Factory)
' =====================================================
namespace Fabrique {
    abstract class FabriqueSysteme {
        # FabriqueSysteme()
        + {abstract} creerSysteme() : unique_ptr<Machine::Systeme>&
        + creerExecuteur(sys : Machine::Systeme*) : unique_ptr<Execution::Executeur>&
        + creerInterfaceConsole() : unique_ptr<Console::InterfaceConsole>&
    }

    class FabriqueCompact {
        + creerSysteme() : unique_ptr<Machine::Systeme>&
    }

    class FabriquePro {
        + creerSysteme() : unique_ptr<Machine::Systeme>&
    }
}

' =====================================================
'  NOTIFICATION (pattern Observer)
' =====================================================
namespace Notification {
    enum Etat {
        M_EAU
        M_THE
        CORRECT
    }

    abstract class Observateur {
        {static} SEUIL_QTE_THE : double = 10.0 (g)
        {static} SEUIL_QTE_EAU : double = 500.0 (mL)
        + {abstract} ~Observateur()
        + {abstract} notifier(qte : double) : void
        + {abstract} notifier(the : const string&, qte : double) : void
    }

    abstract class Notificateur {
        # observateurs_ : vector<Observateur*>
        # etatEau_ : Etat
        # etatThe_ : Etat
        # notificationsActives_ : bool
        # Notificateur()
        # notifier(qte : double) : void
        # notifier(the : const string&, qte : double) : void
        + {abstract} ~Notificateur()
        + activerNotifications(activer : bool) : void
        + ajouterObservateur(o : Observateur*) : void
        + retirerObservateur(o : Observateur*) : void
        + obtenirEtatEau() : Etat
        + obtenirEtatThe() : Etat
        + mettreEtatEau(e : Etat) : void
        + mettreEtatThe(e : Etat) : void
    }

    class Ecran {
        - reserve_ : Machine::Reserve*
        + Ecran(reserve : Machine::Reserve*)
        + notifier(qte : double) : void
        + notifier(the : const string&, qte : double) : void
    }

    class AppDistant {
        - reserve_ : Machine::Reserve*
        + AppDistant(reserve : Machine::Reserve*)
        + notifier(qte : double) : void
        + notifier(the : const string&, qte : double) : void
    }
}

' =====================================================
'  ROUTINE (pattern Strategy)
' =====================================================
namespace Routine {
    abstract class IRoutine {
        # IRoutine()
        + {abstract} ~IRoutine()
        + {abstract} appliquer(sys : Machine::Systeme*) : void {query}
    }

    class Solo {
        # Solo()
        + appliquer(sys : Machine::Systeme*) : void {query}
    }

    class Duo {
        # Duo()
        + appliquer(sys : Machine::Systeme*) : void {query}
    }

    class Matin {
        # Matin()
        + appliquer(sys : Machine::Systeme*) : void {query}
    }
}

' =====================================================
'  MACHINE
' =====================================================
namespace Machine {
    enum TypeRoutine {
        Solo
        Duo
        Matin
    }

    abstract class Systeme {
        - reserve_ : unique_ptr<Reserve>
        - distributeurEau_ : unique_ptr<DistributeurEau>
        - distributeurThe_ : unique_ptr<DistributeurThe>
        - systemeChauffage_ : unique_ptr<SystemeChauffage>
        - infuseur_ : unique_ptr<Infuseur>
        - rinceur_ : unique_ptr<Rinceur>
        - ecran_ : unique_ptr<Notification::Ecran>
        - app_ : unique_ptr<Notification::AppDistant>
        - routine_ : unique_ptr<Routine::IRoutine>
        - portions_ : unsigned int
        - theSelectionne_ : string
        - quitter_ : bool
        # Systeme(reserve, dEau, dThe, sysChauff)
        + {abstract} ~Systeme()
        + infuser(nomThe : const string&) : void
        + remplirThe(nom : const string&, quantite : double) : void
        + remplirEau(quantite : double) : void
        + afficherReserves() : void {query}
        + activerNotifications(activer : bool) : void
        + quitter(oui : bool) : bool
        + doitQuitter() : bool
        + ajouterObservateur(o : Notification::Observateur*) : void
        + theSelectionne() : const string& {query}
        + portions() : unsigned int {query}
        + modifierPortions(portions : unsigned int) : void
        + modifierTheSelectionne(the : const string&) : void
        + appliquerRoutine(r : shared_ptr<Routine::IRoutine>&) : void
    }

    class SystemeCompact
    class SystemePro

    ' ---- Réserve ----
    class The <<struct>> {
        + nom : string
        + quantiteService : double = 5.0 (g)
        + volumeRincage : double = 0.0 (mL)
        + volumeService : double = 250.0 (mL)
        + temperatureInfusion : double (°C)
        + tempsInfusion : double (s)
        + quantite : double = 20.0 (g)
    }

    class TheVert <<struct>>
    class TheNoir <<struct>>
    class TheOolong <<struct>>

    class Reserve {
        - qteEau_ : double
        - thes_ : unordered_map<string, The>
        + Reserve()
        + distribuerEau(qte : double, ratio : double) : void
        + distribuerThe(the : const string&, qte : double, ratio : double) : void
        + activerNotifications(activer : bool) : void
        + remplirThe(the : const string&, qte : double) : void
        + remplirEau(qte : double) : void
        + ajouterThe(the : const The&) : void
        + theSuffisant(nomThe : const string&, quantite : double, ratio : double) : void {query}
        + obtenirThe(nomThe : const string&) : const The& {query}
        + eauSuffisante(quantite : double, ratio : double) : void {query}
        + afficherReserves() : void {query}
    }

    class EauInsuffisante {
        - quantiteRequise_ : double
        - quantiteDisponible_ : double
        - message_ : string
        + EauInsuffisante(quantiteRequise : double, quantiteDisponible : double)
        + what() : const char* {query}
    }

    class TheInsuffisant {
        - the_ : string
        - quantiteRequise_ : double
        - quantiteDisponible_ : double
        - message_ : string
        + TheInsuffisant(the : const string&, quantiteRequise : double, quantiteDisponible : double)
        + what() : const char* {query}
    }

    ' ---- Distributeur eau ----
    abstract class DistributeurEau {
        # reserve_ : Reserve*
        # ratio_ : double
        # DistributeurEau(reserve : Reserve*, ratioSurplus : double)
        + {abstract} ~DistributeurEau()
        + distribuerEau(quantite : double) : void
        + obtenirRatio() : double {query}
    }
    class DistributeurEauCompact {
        + DistributeurEauCompact(reserve : Reserve*)
    }
    class DistributeurEauPro {
        + DistributeurEauPro(reserve : Reserve*)
    }

    ' ---- Distributeur thé ----
    abstract class DistributeurThe {
        # reserve_ : Reserve*
        # ratio_ : double
        # DistributeurThe(reserve : Reserve*, ratioSurplus : double)
        + {abstract} ~DistributeurThe()
        + distribuerThe(the : const string&, quantite : double) : void
        + obtenirThe(the : const string&) : const The&
        + obtenirRatio() : double {query}
    }
    class DistributeurTheCompact {
        + DistributeurTheCompact(reserve : Reserve*)
    }
    class DistributeurThePro {
        + DistributeurThePro(reserve : Reserve*)
    }

    ' ---- Système de chauffage ----
    abstract class SystemeChauffage {
        # vitesse_ : double
        # SystemeChauffage(vitesse : double)
        + {abstract} ~SystemeChauffage()
        + chaufferEauRincage(temperature : double) : void
        + chaufferEau(temperature : double) : void
    }
    class SystemeChauffageCompact
    class SystemeChauffagePro

    ' ---- Préparation ----
    class Infuseur {
        - distributeurEau_ : DistributeurEau*
        - distributeurThe_ : DistributeurThe*
        - systemeChauffage_ : SystemeChauffage*
        + Infuseur(dEau : DistributeurEau*, dThe : DistributeurThe*, chauff : SystemeChauffage*)
        + infuser(the : const string&) : void
    }

    class Rinceur {
        - distributeurEau_ : DistributeurEau*
        - distributeurThe_ : DistributeurThe*
        - systemeChauffage_ : SystemeChauffage*
        + Rinceur(dEau : DistributeurEau*, dThe : DistributeurThe*, chauff : SystemeChauffage*)
        + rincer(the : const string&) : void
    }
}

' =====================================================
'  RELATIONS
' =====================================================

' ---- Héritage : commandes ----
CMD.Commande <|-- CMD.CmdAide
CMD.Commande <|-- CMD.CmdApercu
CMD.Commande <|-- CMD.CmdConfig
CMD.Commande <|-- CMD.CmdInfuser
CMD.Commande <|-- CMD.CmdNotif
CMD.Commande <|-- CMD.CmdPortion
CMD.Commande <|-- CMD.CmdQuit
CMD.Commande <|-- CMD.CmdRemplirEau
CMD.Commande <|-- CMD.CmdRemplirThe
CMD.Commande <|-- CMD.CmdReserve
CMD.Commande <|-- CMD.CmdRoutine
CMD.Commande <|-- CMD.CmdSelection

' ---- Commande ----
CMD.Commande *-- Console.Instruction : instruction_
CMD.Commande ..> Machine.Systeme : agit sur
CMD.CmdRoutine --> Machine.TypeRoutine

' ---- Console ----
Console.Instruction --> Console.TypeInstruction : type
Console.InterfaceConsole ..> Console.Instruction : produit
Console.InterfaceConsole ..> Console.Mot : utilise

' ---- Exécution ----
Execution.Executeur o--> Machine.Systeme : sys_
Execution.Executeur *--> Execution.Historique : hist_
Execution.Executeur ..> CMD.Commande : crée / exécute
Execution.Executeur ..> Console.Instruction
Execution.Historique o--> "0..*" CMD.Commande : Reversibles_
Execution.Historique o--> "0..1" CMD.Commande : dernierUndo_

' ---- Fabrique ----
Fabrique.FabriqueSysteme <|-- Fabrique.FabriqueCompact
Fabrique.FabriqueSysteme <|-- Fabrique.FabriquePro
Fabrique.FabriqueSysteme ..> Machine.Systeme : <<create>>
Fabrique.FabriqueSysteme ..> Execution.Executeur : <<create>>
Fabrique.FabriqueSysteme ..> Console.InterfaceConsole : <<create>>
Fabrique.FabriqueCompact ..> Machine.SystemeCompact : <<create>>
Fabrique.FabriquePro ..> Machine.SystemePro : <<create>>

' ---- Système ----
Machine.Systeme <|-- Machine.SystemeCompact
Machine.Systeme <|-- Machine.SystemePro
Machine.Systeme *-- Machine.Reserve
Machine.Systeme *-- Machine.DistributeurEau
Machine.Systeme *-- Machine.DistributeurThe
Machine.Systeme *-- Machine.SystemeChauffage
Machine.Systeme *-- Machine.Infuseur
Machine.Systeme *-- Machine.Rinceur
Machine.Systeme *-- Notification.Ecran
Machine.Systeme *-- Notification.AppDistant
Machine.Systeme *-- "0..1" Routine.IRoutine
Machine.Systeme ..> Notification.Observateur : ajouterObservateur

Machine.SystemeCompact ..> Machine.DistributeurEauCompact
Machine.SystemeCompact ..> Machine.DistributeurTheCompact
Machine.SystemeCompact ..> Machine.SystemeChauffageCompact
Machine.SystemePro ..> Machine.DistributeurEauPro
Machine.SystemePro ..> Machine.DistributeurThePro
Machine.SystemePro ..> Machine.SystemeChauffagePro

' ---- Distributeurs / chauffage ----
Machine.DistributeurEau <|-- Machine.DistributeurEauCompact
Machine.DistributeurEau <|-- Machine.DistributeurEauPro
Machine.DistributeurThe <|-- Machine.DistributeurTheCompact
Machine.DistributeurThe <|-- Machine.DistributeurThePro
Machine.SystemeChauffage <|-- Machine.SystemeChauffageCompact
Machine.SystemeChauffage <|-- Machine.SystemeChauffagePro

Machine.DistributeurEau o--> Machine.Reserve : reserve_
Machine.DistributeurThe o--> Machine.Reserve : reserve_
Machine.DistributeurThe ..> Machine.The

' ---- Préparation ----
Machine.Infuseur o--> Machine.DistributeurEau
Machine.Infuseur o--> Machine.DistributeurThe
Machine.Infuseur o--> Machine.SystemeChauffage
Machine.Rinceur o--> Machine.DistributeurEau
Machine.Rinceur o--> Machine.DistributeurThe
Machine.Rinceur o--> Machine.SystemeChauffage

' ---- Réserve / thé ----
Machine.The <|-- Machine.TheVert
Machine.The <|-- Machine.TheNoir
Machine.The <|-- Machine.TheOolong
Machine.Reserve *-- "0..*" Machine.The : thes_
Machine.Reserve ..> Machine.EauInsuffisante : <<throws>>
Machine.Reserve ..> Machine.TheInsuffisant : <<throws>>
Machine.EauInsuffisante -up-|> std.exception
Machine.TheInsuffisant -up-|> std.exception

' ---- Observer ----
Notification.Notificateur <|-- Machine.Reserve
Notification.Notificateur o--> "0..*" Notification.Observateur : observateurs_
Notification.Notificateur --> Notification.Etat
Notification.Observateur <|-- Notification.Ecran
Notification.Observateur <|-- Notification.AppDistant
Notification.Ecran o--> Machine.Reserve : reserve_
Notification.AppDistant o--> Machine.Reserve : reserve_

' ---- Routine (Strategy) ----
Routine.IRoutine <|-- Routine.Solo
Routine.IRoutine <|-- Routine.Duo
Routine.IRoutine <|-- Routine.Matin
Routine.IRoutine ..> Machine.Systeme : appliquer()

@enduml